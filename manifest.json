{
  "manifest_version": 3,
  "name": "Google Drive 权限扫描器",
  "version": "0.6.3",
  "description": "直观、便利、自动化地扫描并管理 Google Drive 所有文件与表格的共享权限，支持双层白名单与定期自动巡检。",
  "key": "",
  "action": {
    "default_title": "打开 Google Drive 权限管理中心"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["identity", "storage", "unlimitedStorage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "oauth2": {
    "client_id": "替换为你的 Chrome 扩展 OAuth Client ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive"]
  }
}
